---
import Layout from '../../layouts/Layout.astro';
import integrationsData from '../../data/integrations.json';
import type { IntegrationRecord } from '../../types/integration';
import { getAllCategories, slugify, type CategoryMetadata } from '../../utils/slugs';

export async function getStaticPaths() {
  const records = integrationsData as IntegrationRecord[];
  const categories = getAllCategories(records);

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      allCategories: categories,
      allIntegrations: records,
    },
  }));
}

interface Props {
  category: CategoryMetadata;
  allCategories: CategoryMetadata[];
  allIntegrations: IntegrationRecord[];
}

const { category, allCategories, allIntegrations } = Astro.props;

// Other categories for sidebar/footer browsing
const otherCategories = allCategories
  .filter((c) => c.slug !== category.slug)
  .slice(0, 8);

// Schema.org CollectionPage
const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${category.name} Integrations Directory`,
  "description": `Comprehensive directory of verified B2B software integrations in ${category.name}.`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": category.integrations.length,
    "itemListElement": category.integrations.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": item.metaTitle,
      "url": new URL(`/integrations/${item.slug}`, Astro.site || 'https://b2b-integrations.vercel.app').href,
    })),
  },
};
---

<Layout
  title={`${category.name} SaaS Integrations & Automation Guides (2026) | SaaSConnect`}
  description={`Discover verified ${category.name} integrations. Connect tools including ${category.tools.join(', ')} natively or via Make and Zapier automation.`}
  schema={schemaData}
>
  <div class="category-hub-page">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-container" aria-label="Breadcrumb">
      <div class="page-container">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Home</a>
          </li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item">
            <a href="/#explore-integrations" class="breadcrumb-link">Categories</a>
          </li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item active" aria-current="page">
            {category.name}
          </li>
        </ol>
      </div>
    </nav>

    <div class="page-container">
      <!-- Category Hero Header -->
      <header class="category-hero">
        <div class="hero-badge-wrap">
          <span class="category-tag">📂 Category Silo</span>
          <span class="hub-badge">{category.tools.length} SaaS Platforms</span>
        </div>

        <h1 class="hero-title">
          <span class="category-highlight">{category.name}</span> Integrations & Workflows
        </h1>

        <p class="hero-description">
          Field-tested integration guides and automated pipelines for <strong>{category.name}</strong> tools ({category.tools.join(', ')}). Eliminate manual data entry and synchronize workflows across your B2B stack.
        </p>

        <!-- Stats Bar -->
        <div class="category-stats-grid">
          <div class="stat-card">
            <div class="stat-num">{category.integrations.length}</div>
            <div class="stat-lbl">Active Blueprints</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">{category.tools.length}</div>
            <div class="stat-lbl">Tools Represented</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">{category.nativeCount}</div>
            <div class="stat-lbl">Native Direct Connectors</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">~{category.avgSetupTime}m</div>
            <div class="stat-lbl">Avg. Setup Time</div>
          </div>
        </div>
      </header>

      <!-- Category Tools Grid -->
      <section class="tools-in-category-section">
        <div class="section-header-compact">
          <h2 class="section-subtitle-sm">Supported Software in {category.name}</h2>
          <span class="section-hint">Click a tool to explore all its inbound and outbound connections:</span>
        </div>

        <div class="tools-chips-list">
          {category.tools.map((toolName) => (
            <a href={`/tools/${slugify(toolName)}`} class="tool-chip-btn">
              <span class="chip-icon">⚡</span>
              <span class="chip-label">{toolName}</span>
              <span class="chip-arrow">→</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Integrations Matrix Section -->
      <section class="integrations-list-section">
        <div class="section-toolbar">
          <div>
            <h2 class="section-heading">Verified {category.name} Guides ({category.integrations.length})</h2>
            <p class="section-subheading">Step-by-step connection blueprints with verified triggers and API mappings.</p>
          </div>

          <div class="search-input-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="category-integration-search"
              placeholder={`Search within ${category.name}...`}
              aria-label={`Search within ${category.name}`}
            />
          </div>
        </div>

        <div class="integrations-grid" id="category-integrations-grid">
          {category.integrations.map((item) => (
            <article
              class="integration-card"
              data-tools={`${item.toolA} ${item.toolB}`}
              data-middleware={item.recommendedMiddleware}
              data-native={item.nativeIntegration ? 'true' : 'false'}
            >
              <div class="card-header">
                <div class="card-badges">
                  <span class={`type-badge ${item.nativeIntegration ? 'native' : 'middleware'}`}>
                    {item.nativeIntegration ? '⚡ Native' : `🔄 ${item.recommendedMiddleware}`}
                  </span>
                  <span class={`diff-badge diff-${item.difficulty.toLowerCase()}`}>
                    {item.difficulty}
                  </span>
                </div>
                <span class="card-time">⏱️ ~{item.setupTimeMinutes}m</span>
              </div>

              <div class="card-body">
                <div class="connection-flow">
                  <span class="flow-pill main">{item.toolA}</span>
                  <span class="flow-arrow">➔</span>
                  <span class="flow-pill partner">{item.toolB}</span>
                </div>

                <h3 class="card-title">
                  <a href={`/integrations/${item.slug}`} class="card-title-link">
                    {item.toolA} to {item.toolB} Integration
                  </a>
                </h3>

                <p class="card-desc">{item.metaDescription}</p>

                <div class="card-meta-chips">
                  <span class="meta-chip">{item.toolACategory}</span>
                  <span class="meta-chip-sep">↔</span>
                  <span class="meta-chip">{item.toolBCategory}</span>
                </div>
              </div>

              <div class="card-footer">
                <a href={`/integrations/${item.slug}`} class="btn-card-action">
                  <span>View Step-by-Step Blueprint</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="M12 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div id="no-category-results" class="no-results-box" style="display: none;">
          <p>No matching workflows found in this category.</p>
        </div>
      </section>

      <!-- Other Categories Silos -->
      {otherCategories.length > 0 && (
        <section class="other-categories-section">
          <div class="other-header">
            <h3 class="other-heading">Explore Other Integration Categories</h3>
            <a href="/#explore-integrations" class="view-all-link">All Categories →</a>
          </div>

          <div class="categories-grid">
            {otherCategories.map((cat) => (
              <a href={`/category/${cat.slug}`} class="category-card-pill">
                <div class="cat-pill-left">
                  <span class="cat-name">{cat.name}</span>
                  <span class="cat-meta">{cat.tools.length} Tools • {cat.integrations.length} Workflows</span>
                </div>
                <span class="cat-arrow">→</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<script is:inline>
  const searchInput = document.getElementById('category-integration-search');
  const cards = document.querySelectorAll('#category-integrations-grid .integration-card');
  const noResults = document.getElementById('no-category-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      let matchCount = 0;

      cards.forEach((card) => {
        const toolText = (card.getAttribute('data-tools') || '').toLowerCase();
        const cardText = card.textContent.toLowerCase();

        if (toolText.includes(query) || cardText.includes(query)) {
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = matchCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  .category-hub-page {
    padding-bottom: 4rem;
  }

  .page-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumbs */
  .breadcrumb-container {
    background: rgba(15, 23, 42, 0.4);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.85rem 0;
    margin-bottom: 2.5rem;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.88rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--color-sky);
  }

  .breadcrumb-separator {
    color: var(--text-dim);
  }

  .breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Hero */
  .category-hero {
    background: radial-gradient(circle at 15% 20%, rgba(139, 92, 246, 0.15) 0%, transparent 60%),
                radial-gradient(circle at 85% 75%, rgba(6, 182, 212, 0.1) 0%, transparent 50%),
                rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(12px);
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .category-tag {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.35);
    color: #c4b5fd;
  }

  .hub-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .category-highlight {
    background: linear-gradient(135deg, #a78bfa 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 820px;
    margin-bottom: 2.5rem;
  }

  /* Stats Grid */
  .category-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .stat-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .stat-num {
    font-size: 1.85rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: #a78bfa;
    margin-bottom: 0.25rem;
  }

  .stat-lbl {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  /* Supported Tools in Category */
  .tools-in-category-section {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    margin-bottom: 3.5rem;
  }

  .section-header-compact {
    margin-bottom: 1.25rem;
  }

  .section-subtitle-sm {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .section-hint {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tools-chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tool-chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .tool-chip-btn:hover {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.4);
    color: #c4b5fd;
    transform: translateY(-2px);
  }

  .chip-arrow {
    color: var(--text-dim);
    transition: transform 0.15s ease;
  }

  .tool-chip-btn:hover .chip-arrow {
    color: #c4b5fd;
    transform: translateX(3px);
  }

  /* Section Toolbar */
  .section-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-heading {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .section-subheading {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    min-width: 280px;
    color: var(--text-secondary);
  }

  .search-input-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.9rem;
    width: 100%;
  }

  /* Integrations Grid */
  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .integration-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
    backdrop-filter: blur(8px);
  }

  .integration-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .card-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .type-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .type-badge.native {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .type-badge.middleware {
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .diff-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .diff-badge.diff-easy {
    color: #34d399;
  }

  .diff-badge.diff-intermediate {
    color: #fbbf24;
  }

  .diff-badge.diff-advanced {
    color: #f87171;
  }

  .card-time {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .connection-flow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .flow-pill {
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .flow-pill.main {
    background: rgba(139, 92, 246, 0.15);
    color: #c4b5fd;
    border: 1px solid rgba(139, 92, 246, 0.3);
  }

  .flow-pill.partner {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .flow-arrow {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .card-title {
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.65rem;
  }

  .card-title-link {
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .card-title-link:hover {
    color: var(--color-sky);
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta-chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .meta-chip {
    font-size: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .meta-chip-sep {
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .btn-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.2s ease;
  }

  .btn-card-action:hover {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.4);
    color: #c4b5fd;
    transform: translateX(2px);
  }

  .no-results-box {
    background: rgba(15, 23, 42, 0.5);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem;
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  /* Other Categories Section */
  .other-categories-section {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }

  .other-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .other-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .category-card-pill {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    transition: all 0.2s ease;
  }

  .category-card-pill:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-2px);
  }

  .cat-pill-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cat-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .cat-meta {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .cat-arrow {
    color: var(--text-dim);
    transition: transform 0.15s ease;
  }

  .category-card-pill:hover .cat-arrow {
    color: #c4b5fd;
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .category-hero {
      padding: 2rem 1.5rem;
    }
    .hero-title {
      font-size: 2rem;
    }
    .integrations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
