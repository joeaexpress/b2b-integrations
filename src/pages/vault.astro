---
import Layout from '../layouts/Layout.astro';
import integrationsData from '../data/integrations.json';
import type { IntegrationRecord } from '../types/integration';
import { getVaultCheckoutUrl } from '../utils/affiliate';

const integrations = integrationsData as IntegrationRecord[];
const totalCount = integrations.length;

// Get unique categories for filtering
const categories = Array.from(
  new Set([
    ...integrations.map((i) => i.toolACategory),
    ...integrations.map((i) => i.toolBCategory),
  ])
).sort();

const proCheckoutUrl = getVaultCheckoutUrl('individual', 'vault_pricing_pro');
const agencyCheckoutUrl = getVaultCheckoutUrl('agency', 'vault_pricing_agency');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Enterprise Automation Scenario Vault (100+ Make Blueprints)",
  "image": "https://b2b-integrations.vercel.app/og/default.png",
  "description": "The complete bundle of 100+ verified Make.com scenario JSON files, exponential retry policies, field mapping dictionaries, and commercial agency license.",
  "brand": {
    "@type": "Brand",
    "name": "SaaSConnect"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Individual Pro License",
      "price": "29.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "url": "https://b2b-integrations.vercel.app/vault?tier=individual"
    },
    {
      "@type": "Offer",
      "name": "Agency Commercial License",
      "price": "49.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "url": "https://b2b-integrations.vercel.app/vault?tier=agency"
    }
  ]
};

const siteBaseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://b2b-integrations.vercel.app';
const ogImageUrl = new URL('/og/default.png', siteBaseUrl).href;
---

<Layout
  title="All-in-One Scenario Vault (100+ Make.com Blueprints) | SaaSConnect"
  description="Download all 100+ verified Make automation blueprints, field mapping dictionaries, and error-handling policies in one bundle. Save 300+ dev hours."
  schema={schemaData}
  ogImage={ogImageUrl}
>
  <div class="vault-page">
    <!-- Hero Section -->
    <section class="vault-hero">
      <div class="vault-container">
        <div class="hero-badge-wrap">
          <span class="vault-badge">
            <span class="badge-icon">⚡</span>
            <span>Digital Product • Instant Access</span>
          </span>
          <span class="vault-pill-hot">🔥 100+ Production Scenarios Included</span>
        </div>

        <h1 class="vault-title">
          The Enterprise Automation <br />
          <span class="vault-gradient">Scenario Vault</span>
        </h1>

        <p class="vault-subtitle">
          Skip 300+ engineering hours of trial-and-error. Get instant 1-click import access to <strong>all 100 verified Make.json blueprints</strong>, pre-mapped field dictionaries, exponential retry queues, and commercial agency rights.
        </p>

        <!-- Hero Highlights Grid -->
        <div class="vault-stats-bar">
          <div class="vault-stat">
            <span class="stat-value">100+</span>
            <span class="stat-desc">Production Scenarios</span>
          </div>
          <div class="vault-stat-divider"></div>
          <div class="vault-stat">
            <span class="stat-value">300+ hrs</span>
            <span class="stat-desc">Dev Time Saved</span>
          </div>
          <div class="vault-stat-divider"></div>
          <div class="vault-stat">
            <span class="stat-value">3x</span>
            <span class="stat-desc">Auto-Retry Resilience</span>
          </div>
          <div class="vault-stat-divider"></div>
          <div class="vault-stat">
            <span class="stat-value">100%</span>
            <span class="stat-desc">Commercial Agency License</span>
          </div>
        </div>

        <!-- Quick CTA Actions -->
        <div class="hero-actions">
          <a
            href="#pricing"
            class="btn-primary-glow"
            id="hero-vault-cta"
            data-analytics-event="vault_checkout_click"
            data-position="hero_btn"
          >
            <span>Get the Scenario Vault &rarr;</span>
          </a>
          <a href="#scenario-explorer" class="btn-secondary-ghost">
            <span>Explore All 100 Blueprints ↓</span>
          </a>
        </div>

        <div class="guarantee-micro">
          <span>🛡️ 30-Day 100% Money-Back Guarantee</span>
          <span>•</span>
          <span>⚡ Instant .ZIP Delivery + JSON Files</span>
          <span>•</span>
          <span>🔄 Lifetime Free Updates</span>
        </div>
      </div>
    </section>

    <!-- Visual Value Pillars -->
    <section class="value-pillars-section">
      <div class="vault-container">
        <div class="section-header text-center">
          <h2 class="section-title">Built for Production Reliability</h2>
          <p class="section-subtitle">Why teams choose the Scenario Vault over manual step-by-step setup</p>
        </div>

        <div class="pillars-grid">
          <div class="pillar-card">
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
            <h3 class="pillar-title">1-Click Make.com Import</h3>
            <p class="pillar-desc">
              Every integration comes packaged as a validated `.json` scenario schema. Simply upload to your Make organization and your modules, routes, and data pipes are configured instantly.
            </p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon highlight-cyan">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <h3 class="pillar-title">Pre-Mapped Field Dictionaries</h3>
            <p class="pillar-desc">
              No more guessing nested API keys. Standardized JSON schemas for contacts, deals, invoices, line items, and ticket payloads across HubSpot, Stripe, Salesforce, and 60+ tools.
            </p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon highlight-emerald">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="pillar-title">Enterprise Error Handling</h3>
            <p class="pillar-desc">
              Every workflow includes 3x exponential retry policies, dead-letter catch handlers, HTTP 429 rate-limit backoffs, and idempotency key deduplication routines.
            </p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon highlight-amber">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </div>
            <h3 class="pillar-title">Commercial Agency License</h3>
            <p class="pillar-desc">
              Full rights to deploy and customize all 100 blueprints inside client accounts, bill client retainers, and use in agency deliverable packages with zero attribution.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Matrix Section -->
    <section class="comparison-section">
      <div class="vault-container">
        <div class="section-header text-center">
          <span class="section-badge">ROI Breakdown</span>
          <h2 class="section-title">Manual Setup vs. The Scenario Vault</h2>
          <p class="section-subtitle">Why smart operators invest in pre-built scenario architectures</p>
        </div>

        <div class="comparison-table-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th class="feature-col">Feature / Capability</th>
                <th class="manual-col">Manual Build / Free Guides</th>
                <th class="vault-col">⚡ All-in-One Scenario Vault</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="feature-title">
                  <strong>Total Blueprints Included</strong>
                  <span>Volume of production pipelines</span>
                </td>
                <td class="manual-cell">1 at a time (manual download)</td>
                <td class="vault-cell highlight-cell"><strong>All 100+ Scenarios in 1 .ZIP Bundle</strong></td>
              </tr>
              <tr>
                <td class="feature-title">
                  <strong>Setup & Configuration Time</strong>
                  <span>Average engineering effort</span>
                </td>
                <td class="manual-cell">3–5 hours per integration</td>
                <td class="vault-cell highlight-cell"><strong>&lt; 5 minutes (1-Click Import)</strong></td>
              </tr>
              <tr>
                <td class="feature-title">
                  <strong>Field Mapping Dictionaries</strong>
                  <span>Pre-configured payload schemas</span>
                </td>
                <td class="manual-cell">Manual mapping required</td>
                <td class="vault-cell highlight-cell"><strong>Included & Pre-Mapped JSON</strong></td>
              </tr>
              <tr>
                <td class="feature-title">
                  <strong>Error Queues & Retry Logic</strong>
                  <span>3x exponential backoff safeguards</span>
                </td>
                <td class="manual-cell">Must be manually scripted</td>
                <td class="vault-cell highlight-cell"><strong>Built-in to every blueprint</strong></td>
              </tr>
              <tr>
                <td class="feature-title">
                  <strong>Commercial Client Re-use</strong>
                  <span>Agency & freelancer rights</span>
                </td>
                <td class="manual-cell">Single workspace only</td>
                <td class="vault-cell highlight-cell"><strong>Unlimited Client Accounts (Agency Tier)</strong></td>
              </tr>
              <tr>
                <td class="feature-title">
                  <strong>Future Roadmap Blueprints</strong>
                  <span>New scenarios added to directory</span>
                </td>
                <td class="manual-cell">No automated updates</td>
                <td class="vault-cell highlight-cell"><strong>Free Lifetime Updates Included</strong></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Interactive Scenario Explorer -->
    <section class="explorer-section" id="scenario-explorer">
      <div class="vault-container">
        <div class="section-header text-center">
          <span class="section-badge">Interactive Catalog</span>
          <h2 class="section-title">Explore All 100 Included Scenarios</h2>
          <p class="section-subtitle">Search by software tool, department, or automation use case</p>
        </div>

        <div class="explorer-toolbar">
          <div class="vault-search-box">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="vault-search"
              placeholder="Filter by tool (e.g. Stripe, Salesforce, HubSpot, Slack, Airtable)..."
              aria-label="Filter vault blueprints"
            />
          </div>

          <div class="category-pills" id="category-pills">
            <button class="cat-pill active" data-category="all">All Categories ({totalCount})</button>
            {categories.slice(0, 8).map((cat) => (
              <button class="cat-pill" data-category={cat}>{cat}</button>
            ))}
          </div>
        </div>

        <!-- Scenario Cards Grid -->
        <div class="vault-grid" id="vault-items-grid">
          {integrations.map((item) => (
            <div
              class="vault-item-card"
              data-slug={item.slug}
              data-tools={`${item.toolA} ${item.toolB}`.toLowerCase()}
              data-category-a={item.toolACategory}
              data-category-b={item.toolBCategory}
            >
              <div class="item-header">
                <div class="tool-tags">
                  <span class="tool-pill source">{item.toolA}</span>
                  <span class="arrow-sep">→</span>
                  <span class="tool-pill target">{item.toolB}</span>
                </div>
                <span class="badge-format">.JSON</span>
              </div>

              <h4 class="item-title">{item.toolA} to {item.toolB} Automated Pipeline</h4>
              
              <div class="item-meta">
                <span class="meta-tag">⚡ {item.setupTimeMinutes}m Setup</span>
                <span class="meta-tag">🛡️ {item.difficulty}</span>
                <span class="meta-tag">📦 {item.recommendedMiddleware}</span>
              </div>

              <div class="item-usecases">
                <p class="usecase-preview">{item.topUseCases[0]}</p>
              </div>

              <div class="item-footer">
                <span class="included-tag">✓ Included in Vault</span>
                <a href={`/integrations/${item.slug}`} target="_blank" class="preview-link">
                  View Guide &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>

        <div id="no-results" class="no-results" style="display: none;">
          <p>No scenarios found matching your query. Try searching for a different software tool!</p>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="pricing-section" id="pricing">
      <div class="vault-container">
        <div class="section-header text-center">
          <span class="section-badge highlight">Simple, Transparent Pricing</span>
          <h2 class="section-title">Unlock the Complete Scenario Vault</h2>
          <p class="section-subtitle">Instant download • No monthly subscriptions • Lifetime commercial access</p>
        </div>

        <div class="pricing-cards-grid">
          <!-- Pro Tier -->
          <div class="pricing-card">
            <div class="pricing-header">
              <h3 class="tier-name">Individual Pro</h3>
              <p class="tier-desc">Perfect for internal company workflows, startup operators, and single-team RevOps.</p>
              <div class="price-box">
                <span class="currency">$</span>
                <span class="amount">29</span>
                <span class="billing">/ one-time</span>
              </div>
              <div class="strikethrough-value">Regular Price: <del>$149</del> (80% Off)</div>
            </div>

            <div class="pricing-features">
              <div class="feature-item">✓ <strong>All 100+ Make Scenario Blueprints</strong></div>
              <div class="feature-item">✓ Pre-mapped JSON Payload Dictionaries</div>
              <div class="feature-item">✓ 3x Retry & Error Queue Logic</div>
              <div class="feature-item">✓ Single Company / Workspace Usage</div>
              <div class="feature-item">✓ Instant .ZIP Download & Scenario Files</div>
              <div class="feature-item">✓ Free Lifetime Updates</div>
            </div>

            <a
              href={proCheckoutUrl}
              class="btn-pricing btn-pro"
              id="checkout-pro-btn"
              data-analytics-event="vault_checkout_click"
              data-tier="individual"
              data-position="pricing_table"
              data-checkout-tier="individual"
            >
              <span>Get Individual Pro ($29)</span>
            </a>
            <p class="pricing-micro">🛡️ 30-Day Money-Back Guarantee</p>
          </div>

          <!-- Agency Tier (Featured) -->
          <div class="pricing-card featured">
            <div class="featured-badge">MOST POPULAR • AGENCY CHOICE</div>
            <div class="pricing-header">
              <h3 class="tier-name">Agency Commercial</h3>
              <p class="tier-desc">For digital agencies, automation consultants, and freelancers building client solutions.</p>
              <div class="price-box">
                <span class="currency">$</span>
                <span class="amount">49</span>
                <span class="billing">/ one-time</span>
              </div>
              <div class="strikethrough-value">Regular Price: <del>$399</del> (88% Off)</div>
            </div>

            <div class="pricing-features">
              <div class="feature-item">✓ <strong>Everything in Individual Pro Tier</strong></div>
              <div class="feature-item">✓ <strong>Unlimited Client Account Deployments</strong></div>
              <div class="feature-item">✓ <strong>Full Commercial Re-use & Resale Rights</strong></div>
              <div class="feature-item">✓ White-Label Client Handoff Documentation</div>
              <div class="feature-item">✓ Priority Blueprint Request Access</div>
              <div class="feature-item">✓ Free Lifetime Future Integration Releases</div>
            </div>

            <a
              href={agencyCheckoutUrl}
              class="btn-pricing btn-agency"
              id="checkout-agency-btn"
              data-analytics-event="vault_checkout_click"
              data-tier="agency"
              data-position="pricing_table"
              data-checkout-tier="agency"
            >
              <span>Get Agency Commercial ($49) &rarr;</span>
            </a>
            <p class="pricing-micro">⚡ Instant Unlock • Deploy to Unlimited Clients</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <div class="vault-container">
        <div class="section-header text-center">
          <span class="section-badge">Got Questions?</span>
          <h2 class="section-title">Frequently Asked Questions</h2>
          <p class="section-subtitle">Everything you need to know about the Scenario Vault</p>
        </div>

        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question">
              <span>What exactly do I get when I purchase the Scenario Vault?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>
                You receive instant access to a downloadable master package containing all 100+ Make.com scenario definition files in JSON format. Each blueprint includes fully mapped modules, API payload structures, retry triggers, and error catch routes ready to be uploaded directly into Make in 1 click.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How do I import these JSON files into Make.com?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>
                Inside your Make dashboard, create a new scenario, click the "..." menu at the bottom toolbar, select <strong>"Import Blueprint"</strong>, and select the `.json` file from your downloaded vault folder. All modules, connections, and flow topologies will render immediately.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Can I use these blueprints for client work?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>
                Yes! With the <strong>Agency Commercial License ($49)</strong>, you have unlimited rights to deploy, modify, and package these automations for as many paying clients as you want without paying recurring royalties or attribution.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Do I need a paid Make.com account?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>
                No. You can import and test blueprints on Make's free tier (which includes 1,000 operations per month). For high-volume production operations, you can upgrade your Make plan as needed.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>What is your refund policy?</span>
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>
                We offer a <strong>30-day no-questions-asked money-back guarantee</strong>. If the blueprints do not save you dozens of hours of engineering time, simply contact our support team and we will issue a full refund immediately.
              </p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Bottom Action Banner -->
    <section class="vault-cta-banner">
      <div class="vault-container">
        <div class="cta-inner">
          <h2 class="cta-heading">Ready to Accelerate Your Automation Stack?</h2>
          <p class="cta-sub">
            Join hundreds of RevOps leaders, engineers, and agency founders who build faster with SaaSConnect blueprints.
          </p>
          <div class="cta-buttons">
            <a
              href="#pricing"
              class="btn-primary-glow"
              data-analytics-event="vault_checkout_click"
              data-position="bottom_banner"
            >
              <span>Get the Complete Scenario Vault ($29–$49) &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Instant Checkout Modal (Fallback Flow) -->
  <div id="vault-checkout-modal" class="checkout-modal-backdrop" aria-hidden="true">
    <div class="checkout-modal-card">
      <button id="close-checkout-modal" class="modal-close-btn" aria-label="Close modal">✕</button>
      <div class="modal-header">
        <div class="blueprint-badge">
          <span>⚡ Instant Digital Delivery</span>
        </div>
        <h3 class="checkout-modal-title">Complete Your Scenario Vault Order</h3>
        <p class="checkout-modal-subtitle">
          Selected Tier: <strong id="selected-tier-label" class="tier-highlight">Agency Commercial ($49)</strong>
        </p>
      </div>

      <form id="vault-checkout-form" class="checkout-form">
        <input type="hidden" id="checkout-tier-input" name="tier" value="agency" />
        
        <div class="form-group">
          <label for="checkout-email" class="form-label">Delivery Email Address *</label>
          <input
            type="email"
            id="checkout-email"
            name="email"
            placeholder="alex@company.com"
            required
            class="form-input"
          />
        </div>

        <div class="form-group">
          <label for="checkout-company" class="form-label">Company / Agency Name (Optional)</label>
          <input
            type="text"
            id="checkout-company"
            name="company"
            placeholder="Acme Automation Inc."
            class="form-input"
          />
        </div>

        <div class="checkout-summary-box">
          <div class="summary-line">
            <span>Enterprise Scenario Vault (100+ Make JSONs)</span>
            <span id="summary-price">$49.00</span>
          </div>
          <div class="summary-line highlight">
            <span>Commercial Agency Rights & Lifetime Updates</span>
            <span>Included ($0)</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-total">
            <span>Total Today:</span>
            <span id="summary-total-price" class="total-amount">$49.00</span>
          </div>
        </div>

        <button type="submit" id="submit-checkout-btn" class="btn-complete-checkout">
          <span id="btn-checkout-text">Complete Secure Order & Download Vault ↓</span>
          <span id="btn-checkout-spinner" class="spinner" style="display: none;"></span>
        </button>

        <p class="checkout-disclaimer">
          🔒 256-bit encrypted checkout. Instant .ZIP download + email delivery receipt.
        </p>
      </form>

      <div id="checkout-success-view" class="checkout-success" style="display: none;">
        <div class="success-icon">🎉</div>
        <h4>Order Confirmed!</h4>
        <p>Your download package has been prepared. Click below to download your master bundle:</p>
        <a id="vault-download-all-btn" href="/blueprints/all-scenarios-vault.json" download="saasconnect-scenario-vault.json" class="btn-download-vault-zip">
          📦 Download Master Scenario Vault (.JSON)
        </a>
        <p class="receipt-note">A confirmation copy has also been sent to your email.</p>
      </div>
    </div>
  </div>

  <!-- Interactive Scenario Explorer Script -->
  <script is:inline>
    (function () {
      // Scenario Explorer Search & Filter
      const searchInput = document.getElementById('vault-search');
      const catPills = document.querySelectorAll('.cat-pill');
      const itemCards = document.querySelectorAll('.vault-item-card');
      const noResults = document.getElementById('no-results');

      let currentCategory = 'all';
      let currentQuery = '';

      function filterScenarios() {
        let visibleCount = 0;

        itemCards.forEach((card) => {
          const tools = card.getAttribute('data-tools') || '';
          const slug = card.getAttribute('data-slug') || '';
          const catA = card.getAttribute('data-category-a') || '';
          const catB = card.getAttribute('data-category-b') || '';

          const matchesQuery =
            currentQuery === '' ||
            tools.includes(currentQuery) ||
            slug.includes(currentQuery);

          const matchesCategory =
            currentCategory === 'all' ||
            catA === currentCategory ||
            catB === currentCategory;

          if (matchesQuery && matchesCategory) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.toLowerCase().trim();
          filterScenarios();
        });
      }

      catPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          catPills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          currentCategory = pill.getAttribute('data-category') || 'all';
          filterScenarios();
        });
      });

      // Checkout Modal Handling
      const modal = document.getElementById('vault-checkout-modal');
      const closeModalBtn = document.getElementById('close-checkout-modal');
      const checkoutForm = document.getElementById('vault-checkout-form');
      const successView = document.getElementById('checkout-success-view');
      const tierLabel = document.getElementById('selected-tier-label');
      const tierInput = document.getElementById('checkout-tier-input');
      const summaryPrice = document.getElementById('summary-price');
      const summaryTotal = document.getElementById('summary-total-price');
      const btnText = document.getElementById('btn-checkout-text');
      const btnSpinner = document.getElementById('btn-checkout-spinner');
      const submitBtn = document.getElementById('submit-checkout-btn');

      function openCheckout(tier) {
        if (!modal) return;
        const isAgency = tier === 'agency';
        if (tierInput) tierInput.value = isAgency ? 'agency' : 'individual';
        if (tierLabel) tierLabel.textContent = isAgency ? 'Agency Commercial ($49)' : 'Individual Pro ($29)';
        if (summaryPrice) summaryPrice.textContent = isAgency ? '$49.00' : '$29.00';
        if (summaryTotal) summaryTotal.textContent = isAgency ? '$49.00' : '$29.00';

        if (checkoutForm) checkoutForm.style.display = 'flex';
        if (successView) successView.style.display = 'none';

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeCheckout() {
        if (!modal) return;
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }

      document.querySelectorAll('[data-checkout-tier]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const href = btn.getAttribute('href') || '';
          if (href.startsWith('/vault') || href.startsWith('#')) {
            e.preventDefault();
            const tier = btn.getAttribute('data-checkout-tier') || 'individual';
            openCheckout(tier);
          }
        });
      });

      if (closeModalBtn) closeModalBtn.addEventListener('click', closeCheckout);
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeCheckout();
        });
      }

      if (checkoutForm) {
        checkoutForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (btnText) btnText.style.display = 'none';
          if (btnSpinner) btnSpinner.style.display = 'inline-block';
          if (submitBtn) submitBtn.disabled = true;

          const email = document.getElementById('checkout-email')?.value || '';
          const tier = tierInput?.value || 'individual';

          const payload = {
            event: 'vault_checkout_completed',
            tier,
            email,
            price: tier === 'agency' ? 49 : 29,
            timestamp: Date.now(),
          };

          if (typeof window.dispatchEvent === 'function') {
            window.dispatchEvent(new CustomEvent('saasconnect:telemetry', { detail: payload }));
          }

          setTimeout(() => {
            if (btnText) btnText.style.display = 'inline';
            if (btnSpinner) btnSpinner.style.display = 'none';
            if (submitBtn) submitBtn.disabled = false;
            if (checkoutForm) checkoutForm.style.display = 'none';
            if (successView) successView.style.display = 'flex';
          }, 450);
        });
      }
    })();
  </script>
</Layout>

