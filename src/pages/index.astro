    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .chip-label {
    color: var(--text-muted);
  }

  .card-chip.diff-easy { color: #6ee7b7; }
  .card-chip.diff-intermediate { color: #fcd34d; }
  .card-chip.diff-advanced { color: #fda4af; }

