---
import Layout from '../../layouts/Layout.astro';
import integrationsData from '../../data/integrations.json';
import type { IntegrationRecord } from '../../types/integration';
import { getAllTools, slugify, type ToolMetadata } from '../../utils/slugs';

export async function getStaticPaths() {
  const records = integrationsData as IntegrationRecord[];
  const tools = getAllTools(records);

  return tools.map((tool) => ({
    params: { tool: tool.slug },
    props: {
      tool,
      allTools: tools,
      allIntegrations: records,
    },
  }));
}

interface Props {
  tool: ToolMetadata;
  allTools: ToolMetadata[];
  allIntegrations: IntegrationRecord[];
}

const { tool, allTools, allIntegrations } = Astro.props;

// Other tools in the same category or related
const relatedTools = allTools
  .filter((t) => t.slug !== tool.slug && (t.categorySlug === tool.categorySlug || t.integrations.length > 2))
  .slice(0, 6);

// Structured Data Schema for CollectionPage
const schemaData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tool.name} Integrations & Automations Directory`,
  "description": `Comprehensive directory of verified integrations, native connectors, and automation recipes for ${tool.name}.`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": tool.integrations.length,
    "itemListElement": tool.integrations.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": item.metaTitle,
      "url": new URL(`/integrations/${item.slug}`, Astro.site || 'https://b2b-integrations.vercel.app').href,
    })),
  },
};
const siteBaseUrl = import.meta.env.PUBLIC_SITE_URL || 'https://b2b-integrations.vercel.app';
const ogImageUrl = new URL(`/og/tools/${tool.slug}.png`, siteBaseUrl).href;
---

<Layout
  title={`${tool.name} Integrations & Automation Guides (2026) | SaaSConnect`}
  description={`Explore verified ${tool.name} integrations. Connect ${tool.name} with your CRM, billing, dev, and team communication stack natively or via Make automation.`}
  schema={schemaData}
  ogImage={ogImageUrl}
>
  <div class="tool-hub-page">
    <!-- Breadcrumbs Navigation -->
    <nav class="breadcrumb-container" aria-label="Breadcrumb">
      <div class="page-container">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Home</a>
          </li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item">
            <a href="/#explore-integrations" class="breadcrumb-link">Tools</a>
          </li>
          <li class="breadcrumb-separator">/</li>
          <li class="breadcrumb-item active" aria-current="page">
            {tool.name}
          </li>
        </ol>
      </div>
    </nav>

    <div class="page-container">
      <!-- Tool Hero Header -->
      <header class="tool-hero">
        <div class="hero-category-wrap">
          <a href={`/category/${tool.categorySlug}`} class="category-pill">
            📂 {tool.category}
          </a>
          <span class="hub-badge">SaaS Ecosystem Hub</span>
        </div>

        <h1 class="hero-title">
          <span class="tool-highlight">{tool.name}</span> Integrations & Automation Blueprints
        </h1>

        <p class="hero-description">
          Discover verified step-by-step connection blueprints to sync <strong>{tool.name}</strong> across your enterprise tech stack. Includes native connectors, zero-code middleware recipes, and field-tested architectural best practices.
        </p>

        <!-- Stats Bar -->
        <div class="tool-stats-grid">
          <div class="stat-card">
            <div class="stat-num">{tool.integrations.length}</div>
            <div class="stat-lbl">Active Blueprints</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">{tool.nativeCount}</div>
            <div class="stat-lbl">Native Connectors</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">{tool.middlewareCount}</div>
            <div class="stat-lbl">Middleware Recipes</div>
          </div>
          <div class="stat-card">
            <div class="stat-num">~{tool.avgSetupTime}m</div>
            <div class="stat-lbl">Avg. Setup Time</div>
          </div>
        </div>
      </header>

      <!-- Main Directory Section -->
      <section class="integrations-list-section">
        <div class="section-toolbar">
          <div class="section-title-wrap">
            <h2 class="section-heading">All {tool.name} Workflows ({tool.integrations.length})</h2>
            <p class="section-subheading">Select a target software below to view full field mappings and setup timelines.</p>
          </div>

          <div class="search-input-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="tool-integration-search"
              placeholder={`Filter ${tool.name} connections...`}
              aria-label={`Filter ${tool.name} connections`}
            />
          </div>
        </div>

        <div class="integrations-grid" id="tool-integrations-grid">
          {tool.integrations.map((item) => {
            const isSource = item.toolA.toLowerCase() === tool.name.toLowerCase();
            const counterTool = isSource ? item.toolB : item.toolA;
            const counterCategory = isSource ? item.toolBCategory : item.toolACategory;

            return (
              <article
                class="integration-card"
                data-tools={`${item.toolA} ${item.toolB}`}
                data-middleware={item.recommendedMiddleware}
                data-native={item.nativeIntegration ? 'true' : 'false'}
              >
                <div class="card-header">
                  <div class="card-badges">
                    <span class={`type-badge ${item.nativeIntegration ? 'native' : 'middleware'}`}>
                      {item.nativeIntegration ? '⚡ Native' : `🔄 ${item.recommendedMiddleware}`}
                    </span>
                    <span class={`diff-badge diff-${item.difficulty.toLowerCase()}`}>
                      {item.difficulty}
                    </span>
                  </div>
                  <span class="card-time">⏱️ ~{item.setupTimeMinutes}m</span>
                </div>

                <div class="card-body">
                  <div class="connection-flow">
                    <span class="flow-pill main">{tool.name}</span>
                    <span class="flow-arrow">⟷</span>
                    <span class="flow-pill partner">{counterTool}</span>
                  </div>

                  <h3 class="card-title">
                    <a href={`/integrations/${item.slug}`} class="card-title-link">
                      {item.toolA} to {item.toolB} Integration
                    </a>
                  </h3>

                  <p class="card-desc">{item.metaDescription}</p>

                  <div class="card-meta-chips">
                    <span class="meta-chip">Partner: {counterTool}</span>
                    <span class="meta-chip category">{counterCategory}</span>
                  </div>
                </div>

                <div class="card-footer">
                  <a href={`/integrations/${item.slug}`} class="btn-card-action">
                    <span>View Setup Guide</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14"></path>
                      <path d="M12 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <div id="no-results" class="no-results-box" style="display: none;">
          <p>No matching {tool.name} workflows found for your search query.</p>
        </div>
      </section>

      <!-- Make Automation Hub Banner -->
      <section class="tool-enterprise-banner">
        <div class="enterprise-content">
          <div class="enterprise-badge">⚡ Instant Cloud Automation</div>
          <h2 class="enterprise-title">Connect {tool.name} with 1,000+ Apps on Make</h2>
          <p class="enterprise-desc">
            Build visual workflows, automate data syncs, and trigger real-time actions across your entire stack with verified {tool.name} Make scenarios.
          </p>
        </div>
        <div class="enterprise-action">
          <a
            href="https://www.make.com/en/register?pc=jamlung"
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="btn-tool-make"
            data-analytics-event="outbound_affiliate_click"
            data-partner="Make"
            data-tool-a={tool.name}
            data-position="tool_hub_banner"
          >
            <span>Start Building on Make Free →</span>
          </a>
          <span class="enterprise-hint">⚡ Free tier available • No credit card required</span>
        </div>
      </section>

      <!-- Related Tools Cloud -->
      {relatedTools.length > 0 && (
        <section class="related-tools-section">
          <div class="related-header">
            <h3 class="related-heading">Explore More SaaS Hubs</h3>
            <a href="/#explore-integrations" class="view-all-link">Browse Full Directory →</a>
          </div>

          <div class="tools-pills-grid">
            {relatedTools.map((relTool) => (
              <a href={`/tools/${relTool.slug}`} class="tool-pill-card">
                <div class="pill-info">
                  <span class="pill-name">{relTool.name}</span>
                  <span class="pill-category">{relTool.category}</span>
                </div>
                <span class="pill-count">{relTool.integrations.length} guides</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<script is:inline>
  const searchInput = document.getElementById('tool-integration-search');
  const cards = document.querySelectorAll('#tool-integrations-grid .integration-card');
  const noResults = document.getElementById('no-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      let matchCount = 0;

      cards.forEach((card) => {
        const toolText = (card.getAttribute('data-tools') || '').toLowerCase();
        const cardText = card.textContent.toLowerCase();

        if (toolText.includes(query) || cardText.includes(query)) {
          card.style.display = 'flex';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = matchCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>

<style>
  .tool-hub-page {
    padding-bottom: 4rem;
  }

  .page-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumbs */
  .breadcrumb-container {
    background: rgba(15, 23, 42, 0.4);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.85rem 0;
    margin-bottom: 2.5rem;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.88rem;
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--color-sky);
  }

  .breadcrumb-separator {
    color: var(--text-dim);
  }

  .breadcrumb-item.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Hero */
  .tool-hero {
    background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.12) 0%, transparent 60%),
                radial-gradient(circle at 90% 80%, rgba(56, 189, 248, 0.08) 0%, transparent 50%),
                rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    margin-bottom: 3.5rem;
    backdrop-filter: blur(12px);
  }

  .hero-category-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
    transition: all 0.2s ease;
  }

  .category-pill:hover {
    background: rgba(99, 102, 241, 0.25);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .hub-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .tool-highlight {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.7;
    max-width: 820px;
    margin-bottom: 2.5rem;
  }

  /* Stats Grid */
  .tool-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .stat-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .stat-num {
    font-size: 1.85rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: #38bdf8;
    margin-bottom: 0.25rem;
  }

  .stat-lbl {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  /* Section Toolbar */
  .section-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-heading {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .section-subheading {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .search-input-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    min-width: 280px;
    color: var(--text-secondary);
  }

  .search-input-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-size: 0.9rem;
    width: 100%;
  }

  .search-input-box input::placeholder {
    color: var(--text-muted);
  }

  /* Integrations Grid */
  .integrations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .integration-card {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
    backdrop-filter: blur(8px);
  }

  .integration-card:hover {
    border-color: var(--border-highlight);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .card-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .type-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .type-badge.native {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .type-badge.middleware {
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .diff-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .diff-badge.diff-easy {
    color: #34d399;
  }

  .diff-badge.diff-intermediate {
    color: #fbbf24;
  }

  .diff-badge.diff-advanced {
    color: #f87171;
  }

  .card-time {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .connection-flow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .flow-pill {
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .flow-pill.main {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .flow-pill.partner {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .flow-arrow {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .card-title {
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.65rem;
  }

  .card-title-link {
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .card-title-link:hover {
    color: var(--color-sky);
  }

  .card-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .meta-chip {
    font-size: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .meta-chip.category {
    color: #93c5fd;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .btn-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.2s ease;
  }

  .btn-card-action:hover {
    background: rgba(99, 102, 241, 0.15);
    border-color: rgba(99, 102, 241, 0.4);
    color: #a5b4fc;
    transform: translateX(2px);
  }

  .no-results-box {
    background: rgba(15, 23, 42, 0.5);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3rem;
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  /* Tool Enterprise Banner */
  .tool-enterprise-banner {
    background: radial-gradient(circle at 10% 20%, rgba(16, 185, 129, 0.12) 0%, transparent 60%),
                radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.1) 0%, transparent 60%),
                rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-bottom: 3.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .enterprise-content {
    flex: 1;
    min-width: 300px;
  }

  .enterprise-badge {
    display: inline-flex;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #6ee7b7;
    margin-bottom: 1rem;
  }

  .enterprise-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .enterprise-desc {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.6;
    max-width: 680px;
  }

  .enterprise-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .btn-tool-make {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(99, 102, 241, 0.5);
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
    white-space: nowrap;
  }

  .btn-tool-make:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.5);
    color: #ffffff;
  }

  .enterprise-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Related Tools Section */
  .related-tools-section {
    background: rgba(15, 23, 42, 0.4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }

  .related-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .related-heading {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .view-all-link {
    color: var(--color-sky);
    font-size: 0.9rem;
    font-weight: 600;
    transition: transform 0.15s ease;
  }

  .view-all-link:hover {
    transform: translateX(3px);
  }

