---
// DownloadBlueprintModal.astro - Gated Blueprint JSON Download & RevOps Email Capture Modal
---

<div id="blueprint-modal-backdrop" class="blueprint-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="blueprint-modal-card">
    <!-- Close Button -->
    <button id="close-blueprint-modal" class="modal-close-btn" aria-label="Close modal">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="modal-header">
      <div class="blueprint-badge">
        <span class="badge-icon">📦</span>
        <span>Ready-to-Import JSON Template</span>
      </div>
      <h2 class="modal-title">Download <span id="blueprint-flow-title" class="title-highlight">Integration</span> Blueprint</h2>
      <p class="modal-subtitle">
        Get the pre-configured workflow schema, error retry policy, and field dictionary file for instant import into Make scenarios or custom microservices.
      </p>
    </div>

    <!-- Email Capture Form -->
    <form id="blueprint-download-form" class="blueprint-form">
      <input type="hidden" id="blueprint-slug-input" name="slug" value="" />
      <input type="hidden" id="blueprint-tool-a-input" name="toolA" value="" />
      <input type="hidden" id="blueprint-tool-b-input" name="toolB" value="" />

      <div class="form-group">
        <label for="blueprint-email" class="form-label">Work Email *</label>
        <input
          type="email"
          id="blueprint-email"
          name="workEmail"
          placeholder="alex@company.com"
          required
          class="form-input"
        />
      </div>

      <div class="form-group">
        <label for="blueprint-role" class="form-label">Your Role (Optional)</label>
        <select id="blueprint-role" name="role" class="form-select">
          <option value="RevOps / Operations" selected>RevOps / Operations Specialist</option>
          <option value="Software Engineer">Software / Data Engineer</option>
          <option value="Product Manager">Product / Growth Manager</option>
          <option value="Founder / Executive">Founder / Executive</option>
          <option value="Other">Other Technical Role</option>
        </select>
      </div>

      <div class="blueprint-perks">
        <div class="perk-item">✓ Includes 3x Retry Policy & Error Queue Specs</div>
        <div class="perk-item">✓ Pre-mapped JSON Payload Dictionaries</div>
        <div class="perk-item">✓ 1-Click Import into Make Scenarios</div>
      </div>

      <div class="form-footer">
        <button type="submit" id="submit-blueprint-btn" class="btn-download-blueprint">
          <span id="btn-download-text">Unlock & Download Blueprint (.JSON) ↓</span>
          <span id="btn-download-spinner" class="spinner" style="display: none;"></span>
        </button>
        <div class="modal-vault-teaser">
          <span>Need all 100 scenarios for your agency or team?</span>
          <a href="/vault" target="_blank" class="modal-vault-link">Get the Scenario Vault &rarr;</a>
        </div>
        <p class="form-disclaimer">
          🔒 Instant download. We respect your inbox — only occasional high-value architecture updates.
        </p>
      </div>
    </form>

    <!-- Success Confirmation State -->
    <div id="blueprint-success-state" class="blueprint-success-card" style="display: none;">
      <div class="success-icon-wrap">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </div>
      <h3 class="success-title">Blueprint Download Started!</h3>
      <p class="success-desc">
        Your blueprint schema has been saved to your downloads folder. Your browser is now unlocked for all 100 directory blueprints.
      </p>

      <div class="download-fallback-box">
        <span>Didn't start automatically?</span>
        <a id="blueprint-direct-link" href="#" download class="direct-download-link">Click here to download file manually</a>
      </div>

      <!-- High-Converting Scenario Vault Upsell Card -->
      <div class="vault-upsell-card">
        <div class="upsell-badge">⚡ SCALE YOUR AUTOMATION STACK</div>
        <h4 class="upsell-title">Want All 100+ Enterprise Scenarios?</h4>
        <p class="upsell-desc">
          Get instant access to all 100 verified Make.json blueprints, 3x retry policies, and commercial agency rights in one downloadable master bundle.
        </p>
        <a
          href="/vault"
          class="btn-vault-upsell"
          data-analytics-event="vault_upsell_modal_click"
          data-position="modal_success"
        >
          <span>Explore All-in-One Scenario Vault ($29–$49) &rarr;</span>
        </a>
      </div>

      <button id="close-blueprint-success" class="btn-close-success">
        Done & Return to Guide
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const backdrop = document.getElementById('blueprint-modal-backdrop');
    const closeBtn = document.getElementById('close-blueprint-modal');
    const form = document.getElementById('blueprint-download-form');
    const successState = document.getElementById('blueprint-success-state');
    const closeSuccessBtn = document.getElementById('close-blueprint-success');
    const flowTitle = document.getElementById('blueprint-flow-title');
    const slugInput = document.getElementById('blueprint-slug-input');
    const toolAInput = document.getElementById('blueprint-tool-a-input');
    const toolBInput = document.getElementById('blueprint-tool-b-input');
    const directLink = document.getElementById('blueprint-direct-link');
    const submitBtn = document.getElementById('submit-blueprint-btn');
    const btnText = document.getElementById('btn-download-text');
    const btnSpinner = document.getElementById('btn-download-spinner');

    function triggerFileDownload(slug) {
      if (!slug) return;
      const downloadUrl = `/blueprints/${slug}.json`;
      const a = document.createElement('a');
      a.href = downloadUrl;
      a.download = `${slug}-blueprint.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      if (directLink) {
        directLink.href = downloadUrl;
        directLink.download = `${slug}-blueprint.json`;
      }
    }

    function openModal(slug, toolA = '', toolB = '') {
      if (!backdrop) return;
      if (slugInput) slugInput.value = slug;
      if (toolAInput) toolAInput.value = toolA;
      if (toolBInput) toolBInput.value = toolB;

      if (flowTitle) {
        flowTitle.textContent = toolA && toolB ? `${toolA} ↔ ${toolB}` : 'Integration';
      }

      // If user is already unlocked, download immediately without form prompt!
      const alreadyUnlocked = localStorage.getItem('saasconnect_unlocked');
      if (alreadyUnlocked) {
        triggerFileDownload(slug);
        // Show lightweight toast or success state
        if (form) form.style.display = 'none';
        if (successState) successState.style.display = 'flex';
      } else {
        if (form) form.style.display = 'flex';
        if (successState) successState.style.display = 'none';
      }

      backdrop.classList.add('active');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!backdrop) return;
      backdrop.classList.remove('active');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-open-blueprint-modal]');
      if (trigger) {
        e.preventDefault();
        const slug = trigger.getAttribute('data-slug') || '';
        const toolA = trigger.getAttribute('data-tool-a') || '';
        const toolB = trigger.getAttribute('data-tool-b') || '';
        openModal(slug, toolA, toolB);
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeSuccessBtn) closeSuccessBtn.addEventListener('click', closeModal);

    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop && backdrop.classList.contains('active')) {
        closeModal();
      }
    });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const slug = formData.get('slug');
        const toolA = formData.get('toolA');
        const toolB = formData.get('toolB');
        const workEmail = formData.get('workEmail');
        const role = formData.get('role');

        const payload = {
          event: 'lead_magnet_download',
          slug,
          toolA,
          toolB,
          workEmail,
          role,
          pageUrl: window.location.href,
          timestamp: Date.now(),
        };

        if (btnText) btnText.style.display = 'none';
        if (btnSpinner) btnSpinner.style.display = 'inline-block';
        if (submitBtn) submitBtn.disabled = true;

        // Remember unlock state
        try {
          localStorage.setItem('saasconnect_unlocked', 'true');
          localStorage.setItem('saasconnect_email', String(workEmail));
        } catch {}

        // Dispatches telemetry
        if (typeof window.dispatchEvent === 'function') {
          window.dispatchEvent(new CustomEvent('saasconnect:telemetry', { detail: payload }));
        }
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'lead_magnet_download', { slug, tool_a: toolA, tool_b: toolB });
        }
        if (typeof window.plausible === 'function') {
          window.plausible('Blueprint Download', { props: { slug, tool_a: toolA, tool_b: toolB } });
        }

        // Webhook Submission
        const webhookUrl = window.__LEAD_WEBHOOK_URL__ || '';
        if (webhookUrl) {
          try {
            await fetch(webhookUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
          } catch (err) {
            console.warn('[Blueprint] Webhook error:', err);
          }
        }

        setTimeout(() => {
          if (btnText) btnText.style.display = 'inline';
          if (btnSpinner) btnSpinner.style.display = 'none';
          if (submitBtn) submitBtn.disabled = false;

          // Trigger download
          triggerFileDownload(slug);

          form.style.display = 'none';
          if (successState) successState.style.display = 'flex';
        }, 350);
      });
    }
  })();
</script>

<style>
  .blueprint-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(4, 7, 13, 0.8);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .blueprint-modal-backdrop.active {
    opacity: 1;
    pointer-events: auto;
  }

  .blueprint-modal-card {
    background: radial-gradient(circle at 10% 10%, rgba(56, 189, 248, 0.15) 0%, transparent 60%),
                radial-gradient(circle at 90% 90%, rgba(99, 102, 241, 0.12) 0%, transparent 60%),
                #0f172a;
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: var(--radius-xl, 16px);
    max-width: 580px;
    width: 100%;
    padding: 2.25rem;
    position: relative;
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.7), 0 0 35px rgba(56, 189, 248, 0.15);
    max-height: 90vh;
    overflow-y: auto;
    transform: scale(0.95);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blueprint-modal-backdrop.active .blueprint-modal-card {
    transform: scale(1);
  }

  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    transform: rotate(90deg);
  }

  .modal-header {
    margin-bottom: 1.75rem;
  }

  .blueprint-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
    margin-bottom: 1rem;
  }

  .modal-title {
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #f8fafc;
    margin-bottom: 0.5rem;
  }

  .title-highlight {
    color: #38bdf8;
  }

  .modal-subtitle {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.55;
  }

  .blueprint-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .form-input,
  .form-select {
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: #f8fafc;
    font-size: 0.92rem;
    outline: none;
    transition: all 0.2s ease;
    width: 100%;
  }

  .form-input:focus,
  .form-select:focus {
    border-color: #38bdf8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
  }

  .blueprint-perks {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .perk-item {
    font-size: 0.82rem;
    color: #cbd5e1;
    font-weight: 500;
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  .btn-download-blueprint {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border: 1px solid rgba(56, 189, 248, 0.4);
    font-weight: 700;
    font-size: 0.98rem;
    padding: 0.9rem 1.5rem;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 18px rgba(2, 132, 199, 0.4);
  }

  .btn-download-blueprint:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(2, 132, 199, 0.6);
  }

  .form-disclaimer {
    font-size: 0.76rem;
    color: #64748b;
    text-align: center;
    line-height: 1.4;
  }

  /* Success State */
  .blueprint-success-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 0;
  }

  .success-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .success-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 0.5rem;
  }

  .success-desc {
    color: #94a3b8;
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 440px;
    margin-bottom: 1.5rem;
  }

  .download-fallback-box {
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .direct-download-link {
    color: #38bdf8;
    font-weight: 600;
    text-decoration: underline;
  }

  .btn-close-success {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f8fafc;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-close-success:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .modal-vault-teaser {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted, #94a3b8);
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .modal-vault-link {
    color: #38bdf8;
    font-weight: 600;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .modal-vault-link:hover {
    color: #818cf8;
  }

  .vault-upsell-card {
    background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.18) 0%, transparent 80%),
                rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(99, 102, 241, 0.4);
    border-radius: 12px;
    padding: 1.25rem;
    margin: 1.25rem 0 1.5rem;
    text-align: center;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .upsell-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    margin-bottom: 0.6rem;
  }

  .upsell-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 0.4rem;
  }

  .upsell-desc {
    font-size: 0.84rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .btn-vault-upsell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.7rem 1.25rem;
    border-radius: 8px;
    border: 1px solid rgba(99, 102, 241, 0.5);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-vault-upsell:hover {
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
  }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    border-top-color: #ffffff;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

